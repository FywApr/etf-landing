# Copy to .env.local for local development and fill in real values.
# Never commit .env.local. None of these may be exposed as NEXT_PUBLIC_ variables.
#
# The lead form stores nothing until ALL of the values below are set and valid.

# Neon Postgres connection string (pooled), from the Neon console.
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=

# Data controller shown in the privacy notice. Must be the real legal entity
# or person responsible for the data. Do not use placeholders in production.
DATA_CONTROLLER_NAME=
DATA_CONTROLLER_ADDRESS=
DATA_CONTROLLER_EMAIL=

# Version label of the privacy notice text, stored with every lead.
# Change it whenever the notice wording changes, for example 2026-10-13.
PRIVACY_NOTICE_VERSION=

# Keys the one-way hash of client IPs used for per-client rate limiting
# (at least 32 random characters, e.g. `openssl rand -base64 48`). Only used
# when running on Vercel, which supplies a trustworthy client IP. Without it,
# only global rate limits apply.
RATE_LIMIT_SECRET=

# Retention periods in whole days (1-3650). All three are required: without
# them the form stores nothing and funnel events are not recorded. There are
# no defaults, so missing configuration never means "keep forever".
#
# PROVISIONAL: the values below are proposed for this assignment. They are not
# legally mandated or reviewed, and the real data controller must confirm them
# before public launch.
#
# Leads without marketing consent: days after the last guide request.
LEAD_RETENTION_DAYS=30
# Leads with marketing consent: days after the last guide request.
CONSENTED_LEAD_RETENTION_DAYS=365
# Funnel events: days after the event was recorded.
FUNNEL_EVENT_RETENTION_DAYS=90
